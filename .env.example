# ─────────────────────────────────────────────────────────────
# Autonomous Website Tester – environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# PostgreSQL (optional until configured; leave commented to run without a database)
# Docker:  postgresql://awt:awt_dev_password@localhost:5433/awt?schema=public
# Native:  postgresql://awt:<password>@localhost:5432/awt?schema=public
# DATABASE_URL=postgresql://awt:awt_dev_password@localhost:5433/awt?schema=public

# Redis (job queue – optional until Phase 2)
# REDIS_URL=redis://:awt_dev_redis@localhost:6379

# API server
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# 64 hex chars. Generate with: npm run gen:key
JWT_SECRET=

# Credential vault master key (AES-256-GCM, 32 bytes as 64 hex chars).
# Generate with: npm run gen:key   — losing it makes stored credentials unrecoverable.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=1

# Artifact storage: "local" (default) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=awt-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI provider – nothing is hardcoded; provider + models are configuration.
# AI_PROVIDER: anthropic | openai | openai-compatible | none
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_FAST_MODEL=
AI_MAX_TOKENS_PER_RUN=500000

# Local bug fixture site
FIXTURE_PORT=4500

# Development only: exact host:port targets allowed to resolve to private addresses (e.g. the Acme Store fixture).
# ALLOW_PRIVATE_TARGETS=localhost:4500
