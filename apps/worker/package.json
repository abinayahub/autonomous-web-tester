{
  "name": "@awt/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "dotenv -e ../../.env -v NODE_ENV=test -- vitest run src/runner.integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@awt/crypto": "^0.1.0",
    "@awt/db": "^0.1.0",
    "@awt/engine": "^0.1.0",
    "@awt/shared": "^0.1.0",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "playwright": "^1.65.1"
  }
}
